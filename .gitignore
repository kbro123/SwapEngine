# Build output
/build/
/build-*/
/cmake-build-*/
*.o
*.obj
*.a
*.dylib
*.so

# ccache / tooling caches
.cache/
.ccache/

# Vendored dependencies + toolchain (fetched/built locally, never committed)
/third_party/*
!/third_party/.gitkeep

# Golden data is committed; local scratch is not
/tests/golden/scratch/
/bench/results-local/

# Editor / OS
.DS_Store
.idea/
.vscode/
compile_commands.json

# Python bytecode
__pycache__/
*.pyc
