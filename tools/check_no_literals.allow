# Vocabulary-dispatch / interpreter sites ONLY (these strings ARE the dispatch, not a convention choice).
# Format: <path-glob>[:<line>]  <RULE|*>  <regex on literal | *>   # reason
include/swaps/build/day_count.hpp   CONV  .*           # the generic day-count interpreter: `if (dc == "ACT/360")` IS the dispatch
include/swaps/build/day_count.hpp   NUM   .*           # /360.0, /365.0, /252.0 are the day-count definitions themselves
include/swaps/build/calendar.hpp    CONV  ^(Following|Preceding|ModifiedFollowing|ModifiedPreceding)$   # bdc vocabulary dispatch in adjust()
include/swaps/build/observations.hpp CONV  ^(averaged|compounded)$   # accrual-mode vocabulary (not in DB ids anyway)
include/swaps/build/date.hpp:85     NUM   schedule-step-literal   # add_period 'Y' = 12 months: unit conversion, not a schedule
include/swaps/build/conventions.hpp NUM   lag-default   # `int spot_lag = -1` = UNRESOLVED sentinel; conv_from_product throws unless the DB sets it
include/swaps/build/conventions.hpp DBID  ^XCCY-MTM-$   # the product-id SCHEME for pairs (XCCY-MTM-<PAIR>), not a pair choice

