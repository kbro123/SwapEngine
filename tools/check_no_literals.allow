# Vocabulary-dispatch / interpreter sites ONLY (these strings ARE the dispatch, not a convention choice).
# Format: <path-glob>[:<line>]  <RULE|*>  <regex on literal | *>   # reason
include/swaps/build/day_count.hpp   CONV  .*           # the generic day-count interpreter: `if (dc == "ACT/360")` IS the dispatch
include/swaps/build/day_count.hpp   NUM   .*           # /360.0, /365.0, /252.0 are the day-count definitions themselves
include/swaps/build/calendar.hpp    CONV  ^(Following|Preceding|ModifiedFollowing|ModifiedPreceding)$   # bdc vocabulary dispatch in adjust()
include/swaps/build/observations.hpp CONV  ^(averaged|compounded)$   # accrual-mode vocabulary (not in DB ids anyway)
include/swaps/build/date.hpp:85     NUM   schedule-step-literal   # add_period 'Y' = 12 months: unit conversion, not a schedule
include/swaps/build/conventions.hpp NUM   lag-default   # `int spot_lag = -1` = UNRESOLVED sentinel; conv_from_product throws unless the DB sets it
include/swaps/derive/asset_swap.hpp NUM   lag-default   # `settle_lag = -1` = UNRESOLVED sentinel (bonds[].settle_lag fills it)
include/swaps/build/conventions.hpp DBID  ^XCCY-MTM-$   # the product-id SCHEME for pairs (XCCY-MTM-<PAIR>), not a pair choice
api/credit.cpp                      JSONDEF  ^(recovery=cp\.recovery_default|premium_freq=1\.0 / py|recovery=recovery)$   # defaults ARE the DB row (credit.cds_products[]) / the verb-level value
api/bond_future.cpp                 JSONDEF  ^(notional_coupon|round_months)=fut\.   # defaults ARE the DB contract row (bond_futures[])
api/compile.cpp                     CONV     ^Preceding$   # a TURN window starts on the last business day on/before the turn date — the turn's definition, not a market choice
include/swaps/build/calendar.hpp    CONV  ^Unadjusted$   # ISDA bdc vocabulary dispatch in adjust() ("no adjustment")
api/compile.cpp                     CONV  ^Unadjusted$   # roll=false (futures contract dates / the raw turn date) maps to the ISDA "Unadjusted" bdc
api/compile.cpp                     DBID  ^NONE$         # the explicit no-calendar id for an AS-ENTERED date (the turn window is then placed on the index calendar)
api/compile.cpp                     NUM   lag-default    # DateConv.spot_lag = -1 = UNRESOLVED sentinel (date_conv_for_curve always sets it)

